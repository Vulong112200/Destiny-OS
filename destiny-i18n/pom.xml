<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.destinyos</groupId>
    <artifactId>destiny-os</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>destiny-i18n</artifactId>
  <name>Destiny OS :: Vietnamese Labels</name>
  <description>
    Vietnamese label registry. UI_UX_VIETNAMESE_SPEC §1 forbids bare technical
    enums reaching the user; a coverage test makes that enforceable.
  </description>
  <dependencies>
    <dependency>
      <groupId>io.destinyos</groupId>
      <artifactId>destiny-core</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.destinyos</groupId>
      <artifactId>destiny-fusion</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.destinyos</groupId>
      <artifactId>destiny-engine-api</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.destinyos</groupId>
      <artifactId>destiny-ai</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!--
      Can Chi identity enums (Thien Can, Dia Chi, Ngu Hanh, Am Duong, Tiet Khi)
      deliberately carry no display names of their own - HeavenlyStem's Javadoc
      says so explicitly - so their Vietnamese labels live here, which means
      this module needs the calendar on its classpath.
    -->
    <dependency>
      <groupId>io.destinyos</groupId>
      <artifactId>destiny-calendar</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!--
      Thap Than and pillar-position labels. Same precedent as destiny-ai above:
      the label registry is the one place allowed to know about a downstream
      module's user-facing enums, because UI_UX_VIETNAMESE_SPEC section 1 makes
      an unlabelled enum a defect and LabelCoverageTest enforces it centrally.
    -->
    <dependency>
      <groupId>io.destinyos</groupId>
      <artifactId>destiny-engine-bazi</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Bat Trach trigram, direction and du nien labels. Same precedent. -->
    <dependency>
      <groupId>io.destinyos</groupId>
      <artifactId>destiny-engine-fengshui</artifactId>
      <version>${project.version}</version>
    </dependency>
    <!-- Zodiac sign and astrological house labels. Same precedent. -->
    <dependency>
      <groupId>io.destinyos</groupId>
      <artifactId>destiny-engine-astrology</artifactId>
      <version>${project.version}</version>
    </dependency>
  </dependencies>
</project>
