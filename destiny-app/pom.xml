<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.destinyos</groupId>
    <artifactId>destiny-os</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>
  <artifactId>destiny-app</artifactId>
  <name>Destiny OS :: Application</name>
  <description>
    Spring Boot assembly. Also hosts the ArchUnit suite, since only this module
    sees every other module on its classpath.
  </description>
  <dependencies>
    <dependency>
      <groupId>io.destinyos</groupId>
      <artifactId>destiny-execution</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.destinyos</groupId>
      <artifactId>destiny-i18n</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.destinyos</groupId>
      <artifactId>destiny-persistence</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.destinyos</groupId>
      <artifactId>destiny-engine-tarot</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.destinyos</groupId>
      <artifactId>destiny-engine-numerology</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.destinyos</groupId>
      <artifactId>destiny-fusion</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter</artifactId>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.tngtech.archunit</groupId>
      <artifactId>archunit-junit5</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.awaitility</groupId>
      <artifactId>awaitility</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
        <version>${spring-boot.version}</version>
      </plugin>
    </plugins>
  </build>
</project>
