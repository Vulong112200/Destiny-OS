<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.destinyos</groupId>
    <artifactId>destiny-os</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>destiny-api</artifactId>
  <name>Destiny OS :: API</name>
  <description>
    REST controllers (CLAUDE.md section 3: "Controller khong chua domain
    calculation"). Depends on destiny-scenario (which is itself engine-
    agnostic, ADR-equivalent to D5) and destiny-engine-api's SPI only - never
    a concrete destiny-engine-* module. Concrete engines are wired into a
    Spring bean registry by destiny-app, and this module only asks for that
    already-assembled registry; it never imports TarotEngine or
    NumerologyEngine by name. An ArchUnit rule in destiny-app enforces this
    mechanically, the same way ADR D5 protects destiny-fusion.
  </description>

  <dependencies>
    <dependency>
      <groupId>io.destinyos</groupId>
      <artifactId>destiny-scenario</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.destinyos</groupId>
      <artifactId>destiny-persistence</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.destinyos</groupId>
      <artifactId>destiny-i18n</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>io.destinyos</groupId>
      <artifactId>destiny-ai</artifactId>
      <version>${project.version}</version>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>
</project>
