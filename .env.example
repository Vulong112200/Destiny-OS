# Copy this file to `.env` (repo root) and fill in real values there.
# `.env` is gitignored (Master Spec §28) — never commit real credentials.
#
# Where to find these in Supabase: Project Settings → Database →
# "Connection string" → tab "JDBC". Supabase shows a URI like
#   postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@<host>:5432/postgres
# Convert it to the three variables below (JDBC needs the "jdbc:" prefix
# and the driver reads user/password separately, not embedded in the URL).
#
# Use the "Session pooler" host/port (5432), not the "Transaction pooler"
# (6543): Hibernate relies on prepared statements, which the transaction
# pooler does not support. The "Direct connection" (also 5432) works too,
# but needs IPv6 or Supabase's paid IPv4 add-on — the session pooler works
# over plain IPv4 and is the simpler default for local development.

SPRING_DATASOURCE_URL=jdbc:postgresql://<session-pooler-host>:5432/postgres?sslmode=require
SPRING_DATASOURCE_USERNAME=postgres.<project-ref>
SPRING_DATASOURCE_PASSWORD=<your-database-password>

# --- AI Narrative (Phase 12, ADR D8) - entirely optional -------------------
# The system is fully usable with every one of these left unset: the
# narrative endpoint then always returns the deterministic hard-data
# fallback, never an error. Set DESTINY_AI_ENABLED=true AND both an API key
# and a model to turn on real calls to OpenRouter (an OpenAI-compatible
# /chat/completions API, https://openrouter.ai). There is deliberately no
# default model here - OpenRouter's free-tier catalogue changes over time,
# so pick one you have confirmed is currently available on your account.
DESTINY_AI_ENABLED=false
OPENROUTER_API_KEY=
DESTINY_AI_OPENROUTER_MODEL=
