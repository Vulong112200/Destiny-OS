# Copy this file to `.env` (repo root) and fill in real values there.
# `.env` is gitignored (Master Spec §28) — never commit real credentials.
#
# Where to find these in Supabase: Project Settings → Database →
# "Connection string" → tab "JDBC". Supabase shows a URI like
#   postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@<host>:5432/postgres
# Convert it to the three variables below (JDBC needs the "jdbc:" prefix
# and the driver reads user/password separately, not embedded in the URL).
#
# Use the "Session pooler" host/port (5432), not the "Transaction pooler"
# (6543): Hibernate relies on prepared statements, which the transaction
# pooler does not support. The "Direct connection" (also 5432) works too,
# but needs IPv6 or Supabase's paid IPv4 add-on — the session pooler works
# over plain IPv4 and is the simpler default for local development.

# reWriteBatchedInserts=true lets pgjdbc collapse a batch of single-row
# INSERTs into one multi-row INSERT. With the database in another region
# this is the single largest win when recording a calculation, which
# writes one row per evidence item and per signal (~60 for a Tarot Celtic
# Cross). Safe on the session pooler (port 5432); if you move to the
# transaction pooler (6543) add prepareThreshold=0 as well.
SPRING_DATASOURCE_URL=jdbc:postgresql://<session-pooler-host>:5432/postgres?sslmode=require&reWriteBatchedInserts=true
SPRING_DATASOURCE_USERNAME=postgres.<project-ref>
SPRING_DATASOURCE_PASSWORD=<your-database-password>

# --- AI Narrative (Phase 12, ADR D8) - entirely optional -------------------
# The system is fully usable with every one of these left unset: the
# narrative endpoint then always returns the deterministic hard-data
# fallback, never an error. Set DESTINY_AI_ENABLED=true AND both an API key
# and a model to turn on real calls to OpenRouter (an OpenAI-compatible
# /chat/completions API, https://openrouter.ai). There is deliberately no
# default model here - OpenRouter's free-tier catalogue changes over time,
# so pick one you have confirmed is currently available on your account.
DESTINY_AI_ENABLED=false
OPENROUTER_API_KEY=
DESTINY_AI_OPENROUTER_MODEL=

# Hạn chờ MỘT lần gọi HTTP tới OpenRouter, và deadline TỔNG cho cả chuỗi model
# (mọi model + mọi lần retry của một lần sinh diễn giải).
#
# Chỉ đặt timeout-ms là chưa đủ để chặn độ trễ: worst case là phép nhân
# 2 (số lần thử) x số model trong chuỗi x DESTINY_AI_OPENROUTER_TIMEOUT_MS.
# Với 4 model ở 25000ms là 200 giây cho một request — không trình duyệt,
# proxy hay serverless function nào chờ tới lúc đó, nên bản fallback tất định
# vẫn được tạo nhưng không còn ai nghe. DESTINY_AI_OPENROUTER_TOTAL_DEADLINE_MS
# chặn cả chuỗi: hết deadline thì không thử model tiếp theo nữa và trả về lý do
# thất bại cuối cùng.
#
# Deadline chỉ được kiểm tra GIỮA các lần gọi (một lần gọi đang dở không bị
# huỷ), nên worst case thật là TOTAL_DEADLINE_MS + TIMEOUT_MS. Mặc định 45000 +
# 15000 = 60 giây, nằm dưới hạn chờ 75 giây của destiny-web.
DESTINY_AI_OPENROUTER_TIMEOUT_MS=20000
DESTINY_AI_OPENROUTER_TOTAL_DEADLINE_MS=35000

# --- Retention / cleanup (CLAUDE.md §7) ------------------------------------
# Every calculation is stored with a retention class and an expiry, but
# NOTHING is ever deleted unless you switch the cleanup job on here. The job
# is deliberately off by default: a scheduled task that deletes rows should be
# a decision someone made, not something that arrives switched on.
#
# When enabled, it deletes at most DESTINY_RETENTION_BATCH_SIZE expired
# calculations per run and records every run (including dry runs) in the
# retention_runs table. It never deletes a result the user saved via
# POST /api/v1/calculations/{id}/save.
#
# Durations accept Spring's duration syntax (30d, 12h, 90m). The defaults sit
# at the long end of DATA_MODEL_AND_RETENTION.md §8's ranges (7-30 days for
# daily readings, 30-90 for other transient runs) because keeping data too
# long is recoverable and deleting it too early is not.
DESTINY_RETENTION_ENABLED=false
DESTINY_RETENTION_DAILY=30d
DESTINY_RETENTION_TRANSIENT=90d
DESTINY_RETENTION_BATCH_SIZE=500
# Spring cron (second minute hour day month weekday). Default: 03:30 daily.
DESTINY_RETENTION_CRON=0 30 3 * * *

# --- Observability (Phase 14, CLAUDE.md §5) ---------------------------------
# Nothing to configure. Per-engine metrics are always recorded, and the
# operational endpoints are pinned in application.yml to health/info/metrics
# only. /actuator/env and /actuator/configprops are deliberately NOT exposed:
# they would render OPENROUTER_API_KEY and the datasource password to anyone
# who can reach the port (Master Spec §28). ActuatorExposureTest asserts they
# stay 404, so do not "temporarily" widen the exposure list.
